# Secrets: never committed, created with kubectl create secret (section 4.7)
.env
.env.*
*.env
*-secret.yaml
*secret*.yaml
kubeconfig
# Belt-and-suspenders reminder: never commit API keys
*GROQ_API_KEY*
# ...except a placeholder that documents the Secret's shape (values: REPLACE_ME).
# Never list it in kustomization.yaml: applying it would overwrite the real Secret.
!*placeholder*.yaml

# Corpus files you did not write: commit corpus/MANIFEST.md and corpus/fetch.py instead
corpus/raw/
corpus/pdfs/
# Belt-and-suspenders: block PDFs, DOCXs, and large binaries from anywhere in the repo
*.pdf
*.PDF
*.docx
*.DOCX
# Allow the eval fixtures (they are Markdown, not binaries — already not .pdf)
# If you ever add binary fixtures, negate them here: !eval/fixtures/*.pdf

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local scratch
*.log
.DS_Store
.coverage
setup_teammate_commit*.py
